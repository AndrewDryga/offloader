#!/bin/bash
# coop pre-commit gate — runs for every committer (agent or human) via
# core.hooksPath=.githooks, so Codex/Gemini and a plain git commit can't bypass the format
# check the way they bypass Claude-only hooks. Fast by design. Skip once: git commit --no-verify.
set -f          # the file lists below are word-split on purpose; don't also glob-expand a name
IFS=$'\n'       # …and split only on newlines, so a staged filename with a space stays one path
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null) || exit 0

# Elixir: block the commit if any staged .ex/.exs file isn't mix-format clean. Each file is
# checked from the nearest directory with a mix.exs, so that project's .formatter.exs applies:
# from the repo root, a Phoenix router's `plug :accepts` reads as unformatted.
ex_files=$(echo "$staged" | grep -E '\.exs?$' || true)
if [ -n "$ex_files" ] && command -v mix >/dev/null 2>&1; then
  unformatted=""
  for file in $ex_files; do
    project=$(dirname "$file")
    while [ "$project" != "." ] && [ ! -f "$project/mix.exs" ]; do project=$(dirname "$project"); done
    if ! (cd "$project" && mix format --check-formatted "${file#"$project"/}" >/dev/null 2>&1); then
      unformatted="$unformatted  $file"$'\n'
    fi
  done
  if [ -n "$unformatted" ]; then
    echo "pre-commit blocked — these need mix format:" >&2; printf '%s' "$unformatted" >&2
    echo "fix: run mix format inside the file's Mix project   (skip once: git commit --no-verify)" >&2
    exit 1
  fi
fi

exit 0
